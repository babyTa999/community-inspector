# IceWhale CRM Environment Configuration

# Database Configuration
# Option 1: SQLite (default, for development)
DATABASE_URL=sqlite:///data/crm.db

# Option 2: PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/crm

# Application Settings
DEBUG=false
LOG_LEVEL=info

# Server Settings
HOST=0.0.0.0
PORT=8080

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# AI Configuration
# Mode: local | api | hybrid
AI_MODE=local
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Settings
OLLAMA_URL=http://ollama:11434
OLLAMA_LLM_MODEL=deepseek-coder:6.7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Qdrant Settings
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_base

# n8n Settings
N8N_USER=admin
N8N_PASSWORD=icewhale123
N8N_WEBHOOK_URL=http://n8n:5678/webhook

# Webhook URLs for Automation
N8N_WEBHOOK_URL_NEW_ISSUE=http://n8n:5678/webhook/new-issue
N8N_WEBHOOK_URL_HIGH_PRIORITY=http://n8n:5678/webhook/high-priority

# Feishu Webhook for Notifications
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token
